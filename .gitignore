# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# OS
.DS_Store

# Large / regenerable data — never commit the raw dataset
data/raw/*.csv

# Spark ETL intermediates (cleaned Parquet + aggregates) — regenerated by src/spark_etl.py
data/interim/

# Airflow: its own virtualenv and local state (SQLite DB, task logs, generated login)
.venv-airflow/
airflow_home/

# Data-quality gates: their own virtualenv, plus everything with a timestamp or run id —
# per-run results and trend, Great Expectations' working project, generated Data Docs.
# (outputs/quality/latest*.md are deterministic and committed.)
.venv-gx/
outputs/quality/history/
outputs/quality/gx/
outputs/quality/data_docs/

# Jupyter
.ipynb_checkpoints/

# Keep the empty raw/ folder tracked
!data/raw/.gitkeep